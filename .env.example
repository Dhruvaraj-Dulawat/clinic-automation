# ============================================================================
# clinic-automation — environment template (.env.example)
# Copy to .env and fill real values. NEVER commit .env (gitignored).
#
# ZERO SECRETS IN THIS FILE. Every placeholder below is either a redacted
# literal (REPLACE_ME…) or a safe default. Values are validated at boot by
# src/config.js: a malformed value fails LOUDLY and names itself, e.g.
#   [config] CLINIC_HOURS_JSON is invalid: [1,2,notanumber] — days must hold
#   weekday numbers 0-6, found "notanumber" (see .env.example — use [1,2,3,4,5,6] …)
# ============================================================================

# --- Server ---
PORT=3000
DB_PATH=./data/clinic.db
# 'production' turns on secure cookies, HSTS and the strict config validation.
# Leave unset for local dev. Anything other than 'production' is NOT production.
NODE_ENV=development

# --- Sessions (express-session) ---
# Generate a long random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-generate-32-chars-minimum
# Session lifetime in hours. Drives BOTH the cookie maxAge and the SQLite
# session store's expiry sweep, so they cannot drift apart. Default 12.
SESSION_TTL_HOURS=12

# --- Admin bootstrap account ---
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate via:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_BCRYPT_HASH_OF_ADMIN_PASSWORD

# --- WhatsApp Cloud API (Meta) ---
# Local dev: keep MOCK_MODE=true so no real messages are sent (logged only).
WHATSAPP_MOCK_MODE=true
WHATSAPP_TOKEN=REPLACE_ME_WITH_META_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME_WITH_PHATSAPP_PHONE_NUMBER_ID
WHATSAPP_API_VERSION=v21.0
# Must match the verify token you enter in the Meta app dashboard webhook config.
WHATSAPP_VERIFY_TOKEN=REPLACE_ME_WITH_RANDOM_VERIFY_TOKEN
# Owner/staff phone in E.164 for booking alerts + weekly digest, e.g. +919876543210
OWNER_PHONE=+910000000000

# --- Clinic identity + scheduling ---
CLINIC_NAME=Your Clinic Name
# Slot grid: 30-min slots, 09:00-18:00 local time.
# SLOT_* take precedence over CLINIC_HOURS_JSON when both are set
# (SLOT_DURATION_MIN beats SLOT_MINUTES; SLOT_START/END_HOUR beat SLOT_OPEN/CLOSE).
SLOT_DURATION_MIN=30
SLOT_START_HOUR=9
SLOT_END_HOUR=18
# Older aliases for the same two settings, still supported: SLOT_OPEN=09:00 and
# SLOT_CLOSE=18:00 set the window directly, SLOT_MINUTES=30 sets its length.
# Prefer SLOT_DURATION_MIN / SLOT_START_HOUR / SLOT_END_HOUR above.
# SLOT_OPEN=09:00
# SLOT_CLOSE=18:00
# SLOT_MINUTES=30
# Working weekdays, 0=Sunday … 6=Saturday. Default Mon–Sat.
# This is the SHORT form: a bare list of weekday numbers. It is accepted as-is.
CLINIC_HOURS_JSON=[1,2,3,4,5,6]
# The long form below is equivalent and lets you set the window inline. Use ONE
# of the two. Only these five keys are read — a typo is rejected, not ignored:
#   days, open, close, slotMinutes, maxAdvanceDays
# (Shown with the same 09:00-18:00 window as the SLOT_* lines above; note those
# still win if you leave them set.)
# CLINIC_HOURS_JSON={"days":[1,2,3,4,5,6],"open":"09:00","close":"18:00","slotMinutes":30,"maxAdvanceDays":30}

# --- Reverse proxy ---
# Set to 1 (or true/yes/on) ONLY when the app really is behind a proxy you
# control — nginx / Caddy / Cloudflare on the VPS. It makes Express trust
# X-Forwarded-For, which is what the per-IP rate limiter buckets on. Leave it
# unset locally: trusting the header without a proxy lets a client spoof its IP
# and walk straight past the rate limits.
TRUST_PROXY=0

# --- Rate limits (per client IP, in-memory, per process) ---
# Only the request ceiling is tunable; the windows are fixed policy
# (strict = 10 per 10 min, standard = 30 per min, relaxed = 300 per min).
# strict   -> admin login and other sensitive mutations
# standard -> public reads and writes (booking, intake, status)
# relaxed  -> the inbound webhook, which Meta calls in bursts
RATE_LIMIT_STRICT_MAX=10
RATE_LIMIT_STANDARD_MAX=30
RATE_LIMIT_RELAXED_MAX=300

# --- CSRF protection ---
# CSRF is enforced BY DEFAULT and is not opt-in: a cookie-authenticated admin
# mutation without a matching double-submit token is refused with 403.
# Set CSRF_ENFORCE=false ONLY to debug; the app logs a loud SECURITY warning on
# every boot and it must never be set in the production env_file.
CSRF_ENFORCE=true

# --- Receipts (PDF) ---
# Both keys below are OPTIONAL. They are read straight from the environment
# rather than validated by src/config.js, so leaving them commented out is safe.
#
# Receipt and consent PDFs are written to data/receipts by default (created on
# demand). Set RECEIPTS_DIR only to match a different layout, e.g. when
# data/receipts sits on a mounted volume in a container.
# RECEIPTS_DIR=./data/receipts
#
# Amounts print as "Rs. " until a font that genuinely carries the rupee sign
# (U+20B9) is found, and then they print as the real ₹ sign. pdfkit's built-in
# fonts have no such glyph, and it does not report a missing one — it substitutes
# a different character, which silently corrupts the total on a real financial
# document. Usually NO env var is needed: drop a redistributable rupee-capable
# font (Noto Sans, SIL OFL 1.1) at assets/fonts/clinic.ttf and it is picked up
# automatically, as is any other .ttf/.ttc/.otf in that same folder.
# PDF_FONT_PATH is only for a font kept somewhere else, e.g. on a volume.
# PDF_FONT_PATH=/data/fonts/NotoSans-Regular.ttf
# PDF_FONT_REGULAR is accepted as an alias for the same setting.
# The font MUST really contain U+20B9 or it is rejected and ignored. Segoe UI
# Symbol and Lucida Sans both ship with Windows and BOTH lack it, so pointing at
# one looks perfectly valid and quietly leaves you on "Rs. " — the reason is
# written to the log.